Bootstrap: docker
From: {{ base }}

%arguments
    base=ubuntu:noble

%environment
    export DEBIAN_FRONTEND=noninteractive
    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
    export GZ_VERSION=harmonic
    export USERNAME=developer
    export MBARI_WEC_WS=/home/developer/mbari_wec_ws
    export SETUP_SH=/home/developer/setup.bash
    export RUN_SH=/home/developer/run_simulation.bash
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
    # Mirror Docker ENTRYPOINT: source workspace setup on every shell entry
    if [ -f /home/developer/setup.bash ]; then
        . /home/developer/setup.bash
    fi

%post
    export DEBIAN_FRONTEND=noninteractive

    # Necessary tools
    apt-get update \
     && apt-get install -y \
            apt-utils \
            build-essential \
            ca-certificates \
            cmake \
            cppcheck \
            curl \
            doxygen \
            gdb \
            git \
            gnupg2 \
            locales \
            lsb-release \
            python3-dev \
            python3-pip \
            software-properties-common \
            sudo \
            vim \
            wget \
     && apt-get clean

    # Set Locale for ROS 2
    locale-gen en_US en_US.UTF-8
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
    export LANG=en_US.UTF-8

    # Add ROS 2 apt repository
    ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F "tag_name" | awk -F\" '{print $4}')
    curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.$(. /etc/os-release && echo $VERSION_CODENAME)_all.deb"
    dpkg -i /tmp/ros2-apt-source.deb

    # Install ROS 2 Jazzy and Gazebo Harmonic (from ros-gz)
    apt-get update \
     && apt-get install -y \
            python3-rosdep \
            python3-vcstool \
            python3-colcon-common-extensions \
            ros-jazzy-desktop \
            ros-jazzy-rmw-cyclonedds-cpp \
            ros-jazzy-rosbag2-storage-mcap \
            ros-jazzy-sdformat-urdf \
            ros-jazzy-plotjuggler \
            ros-jazzy-plotjuggler-msgs \
            ros-jazzy-plotjuggler-ros \
            ros-jazzy-ros-gz \
            ros-jazzy-gz-sim-vendor \
            ros-jazzy-gz-math-vendor \
     && apt-get clean

    # Added because of the broken PPA and old FSH version
    git clone https://github.com/hamilton8415/FreeSurfaceHydrodynamics.git /tmp/fsh_src \
     && cd /tmp/fsh_src \
     && git checkout TestBeta \
     && mkdir -p build \
     && cd build \
     && cmake .. -DCMAKE_INSTALL_PREFIX=/opt/FreeSurfaceHydrodynamics \
     && make -j1 \
     && make install \
     && ldconfig \
     && rm -rf /tmp/fsh_src

    # For timing in tests, need to use cyclonedds for ROS 2 rather than default
    # rmw provider
    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
    # Using non-official Gazebo + ROS combination, set it explicitly
    export GZ_VERSION=harmonic

    # Create developer home directory (hardcoded build-time path; no actual user account needed)
    mkdir -p /home/developer

    # Create project directory and import packages
    export MBARI_WEC_WS=/home/developer/mbari_wec_ws
    mkdir -p ${MBARI_WEC_WS}/src
    cd ${MBARI_WEC_WS}/src/
    wget https://raw.githubusercontent.com/osrf/mbari_wec/main/mbari_wec_all.yaml
    cat mbari_wec_all.yaml

    cd ${MBARI_WEC_WS}/src
    vcs import < mbari_wec_all.yaml

    # Workaround for gz sim and math python bindings
    python3 -m pip install -i https://mbari-org.github.io/gz-python-bindings/simple gz-python-bindings --break-system-packages

    # Install rosdep dependencies
    apt-get update
    cd ${MBARI_WEC_WS}
    rosdep init
    rosdep update
    rosdep install --from-paths src --ignore-src -r -y -i --rosdistro jazzy
    rm -rf /var/lib/apt/lists/*
    apt-get clean

    # Build the project
    /bin/bash -c "source /opt/ros/jazzy/setup.bash \
      && cd ${MBARI_WEC_WS} \
      && colcon build --parallel-workers 1 --executor sequential"

    # Add quick access scripts
    SETUP_SH=/home/developer/setup.bash
    touch ${SETUP_SH}
    chmod 755 ${SETUP_SH}
    echo ". ${MBARI_WEC_WS}/install/setup.bash" >> ${SETUP_SH}
    echo "export SDF_PATH=\$GZ_SIM_RESOURCE_PATH" >> ${SETUP_SH}

    RUN_SH=/home/developer/run_simulation.bash
    touch ${RUN_SH}
    chmod 755 ${RUN_SH}
    echo ". ${SETUP_SH}" >> ${RUN_SH}
    echo "ros2 launch buoy_gazebo mbari_wec.launch.py pbloghome:=/logs rosbag2:=true" >> ${RUN_SH}

    # Ensure /home/developer tree is world-readable so the calling user can access it
    chmod -R a+rX /home/developer

%startscript
    # Keep the instance alive so that shell sessions can be attached via join.bash
    exec sleep infinity

%runscript
    . /home/developer/setup.bash
    exec /bin/bash "$@"
